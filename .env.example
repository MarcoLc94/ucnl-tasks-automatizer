GROQ_API_KEY=your_groq_api_key_here

# Llave para cifrar las contraseñas de UCNL de cada usuario. Genérala una vez con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la pierdes o la cambias, cada usuario tendrá que volver a capturar su contraseña de UCNL.
SECRET_KEY=

# Máximo de navegadores Chromium abiertos al mismo tiempo (entre todos los usuarios)
MAX_BROWSERS=2

# Opcional: forzar modo headless (true/false). Si no se define, se usa config.yaml
# HEADLESS=true

# Solo para migrar la versión anterior (python manage.py add-user ... --import-legacy)
# UCNL_USERNAME=
# UCNL_PASSWORD=
